{
  "paths": {
    "llama_bin_dir": "D:/llama",
    "models_dir":    "D:/llama/models"
  },
  "models": {
    "f16":    "Llama-3.2-1B-Instruct-f16.gguf",
    "Q8_0":   "Llama-3.2-1B-Instruct-Q8_0.gguf",
    "Q4_K_M": "Llama-3.2-1B-Instruct-Q4_K_M.gguf",
    "Q3_K_M": "Llama-3.2-1B-Instruct-Q3_K_M.gguf"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8089,
    "ctx": 4096,
    "ngl": 99,
    "threads": 6,
    "start_timeout_s": 300,
    "request_timeout_s": 120,
    "extra_args": []
  },
  "decode": {
    "n_predict": 100,
    "seed": 1234
  },
  "cases": {
    "file": "data/cases.jsonl"
  },
  "sessions": [
    {"name": "s1_f16", "model": "f16", "runs": [
      {"run": "f16_P1",           "prompt": "P1", "subset": "all",       "grammar": true},
      {"run": "f16_P2",           "prompt": "P2", "subset": "prompt",    "grammar": true},
      {"run": "f16_P3",           "prompt": "P3", "subset": "prompt",    "grammar": true},
      {"run": "f16_P1_nogrammar", "prompt": "P1", "subset": "nogrammar", "grammar": false}
    ]},
    {"name": "s2_q4", "model": "Q4_K_M", "runs": [
      {"run": "q4_P1",            "prompt": "P1", "subset": "all",       "grammar": true},
      {"run": "q4_P2",            "prompt": "P2", "subset": "prompt",    "grammar": true},
      {"run": "q4_P3",            "prompt": "P3", "subset": "prompt",    "grammar": true},
      {"run": "q4_P1_nogrammar",  "prompt": "P1", "subset": "nogrammar", "grammar": false}
    ]},
    {"name": "s3_q8", "model": "Q8_0", "runs": [
      {"run": "q8_P1",            "prompt": "P1", "subset": "all",       "grammar": true}
    ]},
    {"name": "s4_f16_rerun", "model": "f16", "runs": [
      {"run": "f16_P1_rerun",     "prompt": "P1", "subset": "all",       "grammar": true}
    ]},
    {"name": "s5_q3_optional", "model": "Q3_K_M", "optional": true, "runs": [
      {"run": "q3_P1",            "prompt": "P1", "subset": "all",       "grammar": true}
    ]}
  ]
}
